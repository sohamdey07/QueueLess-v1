# ===================================================
# QueueLess Backend Environment Configuration
# ===================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Frontend Client URL(s) for CORS & Cookies (comma-separated if multiple)
CLIENT_URL=https://your-frontend-domain.com

# Cookie SameSite policy:
# Use 'none' if frontend & backend are on different domains (e.g. vercel.app & onrender.com)
# Use 'lax' if frontend & backend share the same parent domain (e.g. app.domain.com & api.domain.com)
COOKIE_SAME_SITE=none

# Database Connections
# MongoDB Atlas connection string (include database name before query string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/queueless?retryWrites=true&w=majority

# Redis connection string (e.g. Upstash, Redis Cloud, or redis://localhost:6379)
REDIS_URL=rediss://default:<password>@<host>:<port>

# Authentication Secrets (generate with `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=your_32_byte_random_access_token_secret
REFRESH_TOKEN_SECRET=your_32_byte_random_refresh_token_secret

# ImageKit Configuration (for avatar/service uploads)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Google OAuth2 Credentials (Nodemailer email service for OTPs)
GOOGLE_USER=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
